/* ==========================================================
   HERO VISUAL
========================================================== */

.hero-visual {

    position: relative;

    width: 100%;

    max-width: 1250px;

    margin: 80px auto 0;

    padding-bottom: 80px;

}


/* ==========================================================
   SKILLS
========================================================== */

.hero-skills {

    display: flex;

    justify-content: center;

    align-items: center;

    gap: 18px;

    margin-bottom: 60px;

    color: #858585;

    font-size: 14px;

    letter-spacing: .04em;

    white-space: nowrap;

}


/* ==========================================================
   MAIN PRODUCT
========================================================== */

.hero-product {

    position: relative;

    width: 76%;

    margin: 0 auto;

    z-index: 2;

}

.hero-dashboard {

    display: block;

    width: 100%;

    height: auto;

    border-radius: 24px;

    box-shadow:
        0 30px 80px rgba(0,0,0,.12);

}


/* ==========================================================
   FLOATING CARDS
========================================================== */

.hero-card {

    position: absolute;

    width: 220px;

    padding: 24px;

    background: rgba(255,255,255,.94);

    border: 1px solid rgba(0,0,0,.08);

    border-radius: 20px;

    box-shadow:
        0 20px 60px rgba(0,0,0,.10);

    backdrop-filter: blur(20px);

    z-index: 5;

}


.hero-card h3 {

    margin: 16px 0 8px;

    font-size: 18px;

    letter-spacing: -.02em;

}


.hero-card p {

    margin: 0;

    color: #777;

    font-size: 14px;

    line-height: 1.5;

}


.hero-card-icon {

    display: flex;

    align-items: center;

    justify-content: center;

    width: 40px;

    height: 40px;

    border-radius: 50%;

    background: #f5f5f5;

    font-size: 20px;

}


/* ==========================================================
   RESEARCH CARD
========================================================== */

.hero-card-research {

    left: 2%;

    top: 30%;

}


/* ==========================================================
   DESIGN SYSTEM CARD
========================================================== */

.hero-card-system {

    right: 2%;

    top: 38%;

}


/* ==========================================================
   AVATARS
========================================================== */

.hero-avatars {

    display: flex;

    align-items: center;

    margin-top: 20px;

}


.hero-avatars span {

    width: 28px;

    height: 28px;

    margin-left: -6px;

    border-radius: 50%;

    background: #ddd;

    border: 2px solid white;

}


.hero-avatars span:first-child {

    margin-left: 0;

}


.hero-avatars b {

    margin-left: 8px;

    font-size: 12px;

    color: #777;

}


/* ==========================================================
   DESIGN SYSTEM
========================================================== */

.system-icons {

    display: grid;

    grid-template-columns:
        repeat(4, 1fr);

    gap: 6px;

    margin-top: 20px;

}


.system-icons span {

    display: flex;

    align-items: center;

    justify-content: center;

    height: 38px;

    border: 1px solid #eee;

    border-radius: 10px;

    font-size: 12px;

}


/* ==========================================================
   MOBILE MOCKUP
========================================================== */

.hero-mobile {

    position: absolute;

    left: 13%;

    bottom: 45px;

    width: 180px;

    z-index: 6;

    filter:
        drop-shadow(0 20px 35px rgba(0,0,0,.18));

}


.hero-mobile img {

    width: 100%;

    display: block;

}


/* ==========================================================
   PRODUCT CARD
========================================================== */

.hero-product-card {

    position: absolute;

    right: 6%;

    bottom: 20px;

    width: 340px;

    display: flex;

    gap: 18px;

    padding: 18px;

    background: white;

    border: 1px solid #eee;

    border-radius: 20px;

    box-shadow:
        0 20px 60px rgba(0,0,0,.12);

    z-index: 7;

}


.hero-product-card img {

    width: 130px;

    height: 130px;

    object-fit: cover;

    border-radius: 14px;

}


.product-info {

    display: flex;

    flex-direction: column;

    gap: 6px;

}


.product-info span {

    font-size: 13px;

    color: #555;

}


.product-info strong {

    font-size: 16px;

}


.product-info small {

    color: #888;

    font-size: 11px;

}


.product-price {

    margin-top: auto;

    font-size: 20px;

    font-weight: 700;

}


.product-info button {

    padding: 10px 16px;

    border: none;

    border-radius: 10px;

    background: #17181a;

    color: white;

    cursor: pointer;

}
